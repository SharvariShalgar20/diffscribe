Start application-

(You need to some changes that are push to branch)

java -jar target\pr-agent-cli.jar

# No need for --base flag at all

# To print all the chunks to diff.txt
java -jar target\pr-agent-cli.jar --dry-run > diff.txt


# pre-push hook: automatically updates the open PR (if any) for the branch
# being pushed, via pr-agent. Never blocks the actual push - if pr-agent
# fails (no PR yet, backend not running, etc.) that's logged and ignored,
# not treated as a reason to stop the push.

#start backend -
.\mvnw spring-boot:run '-Dspring-boot.run.jvmArguments=-Djava.net.preferIPv4Stack=true'

